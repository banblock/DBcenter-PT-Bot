# 모든 항목은 AMR_ 접두사. 값이 없으면 app/config.py 의 기본값이 쓰인다.

AMR_HOST=0.0.0.0
AMR_PORT=8000
AMR_DEBUG=false
AMR_LOG_LEVEL=INFO

# 프론트(Vite) 오리진. 쉼표 구분. 다른 PC에서 접속하면 실제 프론트 오리진을 추가한다.
AMR_CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://127.0.0.1:5175,http://127.0.0.1:5173

# 프론트의 존 담당 로봇 ID와 반드시 일치해야 한다.
AMR_ROBOT_IDS=AMR-01,AMR-02
AMR_HEARTBEAT_TIMEOUT_SEC=3.0
AMR_ROS_ENABLED=false

# 브리지: null(미연동) | loopback(ROS 없이 명령 로그 확인) | ros2(실장비)
AMR_BRIDGE_BACKEND=loopback
# 1이면 ROS 없이 DB/WS 계약으로 로봇 이동을 재현한다. 실장비 연결 시 0.
AMR_DEMO_SIM=1

# 이벤트/검증
AMR_DEDUP_WINDOW_SEC=10
AMR_INSPECT_ANGLE_COUNT=3
AMR_CONFIDENCE_THRESHOLD=0.6
AMR_VERDICT_CONFIDENCE_THRESHOLD=0.75
AMR_BATTERY_LOW_THRESHOLD=20

# 진압
AMR_SUPPRESSION_MODE=MANUAL
