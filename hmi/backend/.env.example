# 모든 항목은 AMR_ 접두사. 값이 없으면 app/config.py 의 기본값이 쓰인다.

AMR_HOST=0.0.0.0
AMR_PORT=8000
AMR_DEBUG=false
AMR_LOG_LEVEL=INFO

# 프론트(Vite) 오리진. 쉼표 구분
AMR_CORS_ORIGINS=http://localhost:5175,http://localhost:5173

# 로봇
AMR_ROBOT_IDS=amr_1,amr_2
AMR_HEARTBEAT_TIMEOUT_SEC=3.0
AMR_ROS_ENABLED=false

# 이벤트/검증
AMR_DEDUP_WINDOW_SEC=10
AMR_INSPECT_ANGLE_COUNT=3
AMR_CONFIDENCE_THRESHOLD=0.6
AMR_VERDICT_CONFIDENCE_THRESHOLD=0.75
AMR_BATTERY_LOW_THRESHOLD=20

# 진압
AMR_SUPPRESSION_MODE=MANUAL
